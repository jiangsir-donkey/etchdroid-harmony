# ---- 构建产物（与 build.sh 的 sync_mirror --exclude 保持一致） ----
# 注意：gitignore 不支持行尾注释，注释必须单独占一行

# 含 build/sign/：签名 profile、证书链、p7b，绝不入库
/build/
# 已签名 HAP；发布请走 Releases 附件，不要提交
/dist/
/.hvigor/
/oh_modules/
/node_modules/
/entry/build/
/entry/.cxx/
*.hap

# ---- 签名 / 密钥材料（保险起见，任何位置都不提交） ----
*.p12
*.jks
*.keystore
*.pem
*.cer
*.p7b
*.csr

# ---- 本地环境 ----
local.properties
.env

# ---- 编辑器 / 系统 ----
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*.swp
*~
